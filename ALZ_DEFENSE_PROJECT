 = np.vstack(all_images)\n","    all_true = np.concatenate(all_true)\n","\n","    predictions = pretrained_model.predict(all_images)\n","    pred_labels = np.argmax(predictions, axis=1)\n","\n","    if correct:\n","        indices = np.where(pred_labels == all_true)[0]\n","        title = \"Correctly Classified\"\n","    else:\n","        indices = np.where(pred_labels != all_true)[0]\n","        title = \"Misclassified\"\n","\n","    if len(indices) > num_examples:\n","        indices = np.random.choice(indices, num_examples, replace=False)\n","    n = len(indices)\n","    grid = int(np.ceil(np.sqrt(n)))\n","\n","    plt.figure(figsize=(12, 12))\n","    for i, idx_val in enumerate(indices):\n","        plt.subplot(grid, grid, i + 1)\n","        plt.imshow(all_images[idx_val])\n","        true_name = CLASS_NAMES[all_true[idx_val]]\n","        pred_name = CLASS_NAMES[pred_labels[idx_val]]\n","        color = 'green' if correct else 'red'\n","        plt.title(f\"T:{true_name}\\nP:{pred_name}\", fontsize=8, color=color)\n","        plt.axis('off')\n","\n","    plt.suptitle(title, fontsize=14, fontweight='bold')\n","    plt.tight_layout()\n","    plt.show()\n","    plt.close()\n","\n","plot_prediction_examples(correct=True)\n","plot_prediction_examples(correct=False)\n"]},{"cell_type":"markdown","metadata":{"id":"muZ3sSAN54pd"},"source":["# Test on uploaded images (change image path)"]},{"cell_type":"code","execution_count":19,"metadata":{"id":"99HlNxU-54pe","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1788870692607,"user_tz":-360,"elapsed":5277,"user":{"displayName":"Tashdid Rahman 2.4222E+14","userId":"00747877558281012601"}},"outputId":"73d008f1-b48f-47f3-a623-e2855f069b35"},"outputs":[{"output_type":"stream","name":"stdout","text":["Model loaded successfully.\n"]}],"source":["from tensorflow.keras.models import load_model\n","\n","# Load the saved model (from training above)\n","model = load_model('densenet201_finetuned_